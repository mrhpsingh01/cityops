# Local / docker compose
DATABASE_URL=postgres://cityops:cityops_dev@localhost:5432/cityops
PORT=4000
FRONTEND_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Managed Postgres (Neon / Supabase / Render): append ?sslmode=require to DATABASE_URL.
# Set to false only if the provider CA is not trusted by Node:
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# DATABASE_POOL_MAX=10

# FRONTEND_URL accepts comma-separated origins; * wildcards allowed (Vercel previews):
# FRONTEND_URL=https://cityops.vercel.app,https://*.vercel.app

# Optional: Slack/PagerDuty-compatible webhook. Unset = dry-run receipt.
ALERT_WEBHOOK_URL=
# Set to 0 to skip loading the synthetic demo fixture into an empty database.
# SEED_FIXTURE=0

NYC_311_APP_TOKEN=
INGEST_START_DATE=2025-01-01
INGEST_END_DATE=2025-02-01
